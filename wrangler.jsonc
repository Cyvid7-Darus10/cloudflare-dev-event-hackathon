{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rectify",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],

  // The flag board (workstream E). No build step — `public/` ships as it is,
  // so a deploy can never carry a stale bundle. Everything except `/api/*` is
  // served as a static asset before this Worker runs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Workstream B (ingest). toMarkdown() parses the PDF; the extraction call
  // goes over REST to /ai/run with cf-aig-gateway-id so it lands in the
  // hackathon AI Gateway.
  "ai": { "binding": "AI" },

  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "rectify-docs" }
  ],

  "d1_databases": [
    { "binding": "DB", "database_name": "rectify", "database_id": "local-dev" }
  ],

  "workflows": [
    { "binding": "INGEST", "name": "ingest", "class_name": "IngestWorkflow" }
  ],

  // So a deployed URL can say which version it is running.
  "version_metadata": { "binding": "VERSION" },

  // Workstream D: one object per review session, holding flag state and the
  // WebSocket the flag board watches. SQLite-backed so it can hold an audit
  // trail alongside the session.
  "durable_objects": {
    "bindings": [{ "name": "REVIEW_SESSION", "class_name": "ReviewSessionDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReviewSessionDO"] }
  ],

  "observability": { "enabled": true }

  // Still to come — see the shape in plan/stack.md:
  //   browser, kv_namespaces, vectorize, queues, durable_objects + migrations
}
