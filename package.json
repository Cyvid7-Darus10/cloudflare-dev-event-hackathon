{
  "name": "rectify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "tail": "wrangler tail",
    "test": "vp test --run",
    "test:watch": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "migrate:local": "wrangler d1 migrations apply rectify --local",
    "migrate:remote": "wrangler d1 migrations apply rectify --remote",
    "seed-sql": "node scripts/generate-seed.mjs",
    "make-pdf": "node scripts/make-invoices.mjs",
    "verify": "node scripts/verify.mjs https://rectify.cloudflare-hackathon.workers.dev"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/vitest-plugin": "^1.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plus": "^0.3.0",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "agents": "^0.21.0",
    "zod": "^4.4.3"
  }
}
